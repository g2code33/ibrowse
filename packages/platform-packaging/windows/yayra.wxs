<?xml version="1.0" encoding="UTF-8"?>
<!-- Yayra Floating Browser - WiX 64-bit Enterprise MSI Definition -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Yayra" Language="1033" Version="0.1.0.0" Manufacturer="Yayra Project" UpgradeCode="e87d894e-5264-4bf8-b809-58b2db51341e">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="Yayra Floating Browser Setup" Comments="Production 64-bit MSI Package" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" AllowSameVersionUpgrades="no" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Microsoft Edge WebView2 Runtime Registry Detection -->
    <Property Id="WEBVIEW2_MACHINE_PV">
      <RegistrySearch Id="SearchWebView2Machine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Win64="no" />
    </Property>
    <Property Id="WEBVIEW2_USER_PV">
      <RegistrySearch Id="SearchWebView2User" Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>

    <!-- Visual Icons and ARP (Add/Remove Programs) Properties -->
    <Icon Id="AppIcon.ico" SourceFile="build/icons/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://yayra.app" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="yes" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Yayra" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Yayra" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7d2983b0-6421-42fa-9721-e5d4cb5f98a2">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="Yayra" Description="Yayra Floating Browser" Target="[INSTALLFOLDER]yayra.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Yayra" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="98bf7b22-4411-4475-b844-3c65df53b811">
        <Shortcut Id="ApplicationDesktopShortcut" Name="Yayra" Description="Yayra Floating Browser" Target="[INSTALLFOLDER]yayra.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Yayra" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Yayra Application" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="YayraExecutable" Guid="3cb13647-7975-4df6-8d59-a2e6ad1c8901" Win64="yes">
        <File Id="YayraEXE" Source="dist/index.html" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
